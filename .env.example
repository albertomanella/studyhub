# Copia questo file in .env e imposta una password a scelta.
# .env è ignorato da git: non committarlo.

DB_NAME=studyhub_db
DB_USERNAME=studyhub_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Origine del frontend autorizzata dal CORS del backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# true in produzione (HTTPS): il cookie di sessione viaggia solo su HTTPS
SESSION_COOKIE_SECURE=false

# Moderatori: username di account già registrati, separati da virgola.
# Vengono promossi al riavvio del backend; il ruolo vale dal login successivo.
MODERATORS=
